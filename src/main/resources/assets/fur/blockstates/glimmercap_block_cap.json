{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "fur:block/glimmercap_block_cap_side" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "fur:block/glimmercap_block_cap_side", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "fur:block/glimmercap_block_cap_side", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "fur:block/glimmercap_block_cap_side", "y": 270, "uvlock": true }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "fur:block/glimmercap_block_cap_top", "x": 270, "uvlock": true }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "fur:block/glimmercap_block_cap_bottom", "x": 90, "uvlock": true }
    },
    {
      "when": { "north": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside" }
    },
    {
      "when": { "east": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 270, "uvlock": true }
    },
    {
      "when": { "up": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "x": 270, "uvlock": true }
    },
    {
      "when": { "down": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "x": 90, "uvlock": true }
    }
  ]
}
